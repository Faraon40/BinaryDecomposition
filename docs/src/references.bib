@article{SUK20124279,
  title = {Decomposition of binary images—A survey and comparison},
  journal = {Pattern Recognition},
  volume = {45},
  number = {12},
  pages = {4279-4291},
  year = {2012},
  issn = {0031-3203},
  doi = {https://doi.org/10.1016/j.patcog.2012.05.012},
  url = {https://www.sciencedirect.com/science/article/pii/S0031320312002427},
  author = {Tomáš Suk and Cyril Höschl and Jan Flusser},
  keywords = {Binary image decomposition, Distance transform, Quadtree, Bipartite graph, Image compression, Moment computation, Fast convolution},
  abstract = {We present an overview of the most important methods that decompose an arbitrary binary object into a union of rectangles. We describe a run-length encoding and its generalization, decompositions based on quadtrees, on mathematical morphology, on the distance transform, and a theoretically optimal decomposition based on a maximal matching in bipartite graphs. We compare their performance in image compression, in moment computation and in linear filtering. We show that the choice is always a compromise between the complexity and time/memory consumption. We give advice how to select an appropriate method in particular cases.}
}

